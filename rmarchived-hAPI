#!/bin/sh

function Die
{
	echo "$1"
	exit 1
}

MYSQL_USER=archiving

CONFIG_DB_CDRMUNCH=/etc/archiving/conf.d/cdrmunch_database.conf
CONFIG_DB_RETENTION=/etc/archiving/conf.d/retention_database.conf
CONFIG_DB_INTERNAL=/etc/archiving/conf.d/internal_database.conf
CONFIG_ARCHIVED=/etc/archiving/rmarchived.conf
CONFIG_COLLECTD=/etc/archiving/rmcollectd.conf

HOSTTYPE=`hapi get HostType`
if [ $? != 0 ]; then
	Die "Failed to call hapi get HostType"
fi

SEARCHDOMAIN=`hapi get SearchDomain`
if [ $? != 0 ]; then
	Die "Failed to call hapi get SearchDomain"
fi

if [ -f $CONFIG_DB_INTERNAL ]; then
	MYSQL_DB=ArchivingInternal
	MYSQL_RO=`hapi mysql $MYSQL_USER $MYSQL_DB host ro || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB host ro"`
	MYSQL_RW=`hapi mysql $MYSQL_USER $MYSQL_DB host rw || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB host rw"`
	MYSQL_PW=`hapi mysql $MYSQL_USER $MYSQL_DB pass || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB pass"`

	hapi mysql $MYSQL_USER $MYSQL_DB test ro || echo "TEST FAILED TO RO DATABASE CONNECTION: ${MYSQL_USER}@${MYSQL_DB}"
	hapi mysql $MYSQL_USER $MYSQL_DB test rw || echo "TEST FAILED TO RW DATABASE CONNECTION: ${MYSQL_USER}@${MYSQL_DB}"

	sed -i "s/mysql_internal.host\(.*\)/mysql_internal.host = $MYSQL_RW/" $CONFIG_DB_INTERNAL 						|| Die "Unable to set mysql_internal.host in $CONFIG_DB_INTERNAL"
	sed -i "s/mysql_internal.password\(.*\)/mysql_internal.password = $MYSQL_PW/" $CONFIG_DB_INTERNAL				|| Die "Unable to set mysql.password in $CONFIG_DB_INTERNAL"
fi

if [ -f $CONFIG_DB_CDRMUNCH ]; then
	MYSQL_DB=CDR
	MYSQL_RO=`hapi mysql $MYSQL_USER $MYSQL_DB host ro || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB host ro"`
	MYSQL_RW=`hapi mysql $MYSQL_USER $MYSQL_DB host rw || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB host rw"`
	MYSQL_PW=`hapi mysql $MYSQL_USER $MYSQL_DB pass || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB pass"`
	
	hapi mysql $MYSQL_USER $MYSQL_DB test ro || echo "TEST FAILED TO RO DATABASE CONNECTION: ${MYSQL_USER}@${MYSQL_DB}"
	hapi mysql $MYSQL_USER $MYSQL_DB test rw || echo "TEST FAILED TO RW DATABASE CONNECTION: ${MYSQL_USER}@${MYSQL_DB}"

	sed -i "s/mysql_cdrmunch.host\(.*\)/mysql_cdrmunch.host = $MYSQL_RW/" $CONFIG_DB_CDRMUNCH						|| Die "Unable to set mysql_cdrmunch.host in $CONFIG_DB_CDRMUNCH"
	sed -i "s/mysql_cdrmunch.password\(.*\)/mysql_cdrmunch.password = $MYSQL_PW/" $CONFIG_DB_CDRMUNCH				|| Die "Unable to set mysql_cdrmunch.password in $CONFIG_DB_CDRMUNCH"
fi

if [ -f $CONFIG_DB_RETENTION ]; then
	MYSQL_DB=ArchivingRetention
	MYSQL_RO=`hapi mysql $MYSQL_USER $MYSQL_DB host ro || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB host ro"`
	MYSQL_RW=`hapi mysql $MYSQL_USER $MYSQL_DB host rw || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB host rw"`
	MYSQL_PW=`hapi mysql $MYSQL_USER $MYSQL_DB pass || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB pass"`
	
	hapi mysql $MYSQL_USER $MYSQL_DB test ro || echo "TEST FAILED TO RO DATABASE CONNECTION: ${MYSQL_USER}@${MYSQL_DB}"
	hapi mysql $MYSQL_USER $MYSQL_DB test rw || echo "TEST FAILED TO RW DATABASE CONNECTION: ${MYSQL_USER}@${MYSQL_DB}"

	sed -i "s/mysql_retention.host\(.*\)/mysql_retention.host = $MYSQL_RW/" $CONFIG_DB_RETENTION					|| Die "Unable to set mysql_retention.host in $CONFIG_DB_RETENTION"
	sed -i "s/mysql_retention.password\(.*\)/mysql_retention.password = $MYSQL_PW/" $CONFIG_DB_RETENTION			|| Die "Unable to set mysql_retention.password in $CONFIG_DB_RETENTION"
fi

if [ -f $CONFIG_ARCHIVED ]; then
	sed -i "s/coreapi.url\(.*\)/coreapi.url = http\:\/\/api.$SEARCHDOMAIN\//" $CONFIG_ARCHIVED											|| Die "Unable to set coreapi.url in $CONFIG_ARCHIVED"
	sed -i "s/distiller_client.server_host\(.*\)/distiller_client.server_host = cdrmunch.$SEARCHDOMAIN/" $CONFIG_ARCHIVED				|| Die "Unable to set distiller_client.server_host in $CONFIG_ARCHIVED"
	if [ ! `hapi get HostType QA || hapi get HostType DEV` ]; then
		sed -i "s/log.level\(.*\)/log.level = 6/" $CONFIG_ARCHIVED ||  Die "Unable to set log.level in $CONFIG_ARCHIVED"
	fi
fi

if [ -f $CONFIG_COLLECTD ]; then
	sed -i "s/archived_client.server_host\(.*\)/archived_client.server_host = archived.$SEARCHDOMAIN/" $CONFIG_COLLECTD				|| Die "Unable to set archived_client.server_host in $CONFIG_COLLECTD"

	if [ ! `hapi get HostType QA || hapi get HostType DEV` ]; then
		sed -i "s/log.level\(.*\)/log.level = 6/" $CONFIG_COLLECTD || Die "Unable to set log.level in $CONFIG_COLLECTD"
	fi
fi

