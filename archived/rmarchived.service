[Unit]
Description=Archive Daemon
After=network.target network-online.target rmarchived-watchdog.service
BindsTo=rmarchived-watchdog.service

[Service]
EnvironmentFile=-/etc/sysconfig/rmarchived
RuntimeDirectory=archiving
RuntimeDirectoryMode=0700
PIDFile=/var/run/archiving/rmarchived.pid
ExecStartPre=/bin/bash /usr/bin/rmarchived-hAPI
ExecStart=/usr/bin/crash-tracer.sh \
    --config /etc/archiving/rmarchived.conf \
    --service-name rmarchived \
    --binary /usr/bin/rmarchived.bin \
    --pid-file /var/run/archiving/rmarchived.pid \
    -- \
    --hostname $(uname -n | cut -d. -f1)
SyslogIdentifier=rm-archived
# Do not send SIGKILL when the service refuces to shutdown. Call a human instead!
SendSIGKILL=no
# Restart on non-zero exit code...
Restart=on-failure
# ... every 3 seconds...
RestartSec=3s
# ... and never give up
StartLimitInterval=0

[Install]
WantedBy=multi-user.target
