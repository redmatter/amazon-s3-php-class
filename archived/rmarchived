#!/bin/bash
#
# rmarchived     This shell script takes care of starting and stopping
#                the CDR POST Daemon.
#
# chkconfig: 2345 80 05
# description: Archive Daemon
# processname: rmarchived
# config: /etc/rmarchived.conf
# pidfile: /var/run/archiving/rmarchived.pid

prog_longname="Archive Daemon"
prog_shortname=rmarchived
prog_projprefix=archiving
prog_cliopts="--hostname $( uname -n | cut -d. -f1 )"
prog_syslogtag=rm-archived

disk_free_space_KB()
{
	/bin/df "$1" | /usr/bin/tail -n 1 | /bin/awk -F' ' '{print $4}'
}

disk_is_free_enough()
{
	[ "$( disk_free_space_KB $(get_conf $prog_configpath distiller_client.base_dir 0 /var/spool/cdrtmp/cdrmunch-cache ) )" -gt \
			"$(get_conf $prog_configpath distiller_client.base_dir.min_free_space_KB 0 500000)" ] && \
	[ ! -d "$(get_conf $prog_configpath archived.cache_dir 0 /var/lib/archiving/cache)" ] || \
	[ "$( disk_free_space_KB $(get_conf $prog_configpath archived.cache_dir 0 /var/lib/archiving/cache) )" -gt \
			"$(get_conf $prog_configpath archived.cache_dir.min_free_space_KB 0 500000)" ]
}

disk_watch_dog()
{
	sleep 5;
	while _is_alive; do
		if ! disk_is_free_enough; then
			_log err "Insufficient disk space"
			/sbin/service rmarchived stop
		fi
		sleep 1;
	done
}

callback_before_startup()
{
	if ! disk_is_free_enough; then
		_log err "Insufficient disk space"
		return 1;
	fi
	disk_watch_dog &>/dev/null </dev/null &
	/usr/bin/rmarchived-hAPI
}

. /usr/share/rmdaemonscripts/init.sh

