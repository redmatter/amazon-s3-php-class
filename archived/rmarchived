#!/bin/bash
#
# rmarchived     This shell script takes care of starting and stopping
#                the CDR POST Daemon.
#
# chkconfig: 2345 80 05
# description: Archive Daemon
# processname: rmarchived
# config: /etc/rmarchived.conf
# pidfile: /var/run/archiving/rmarchived.pid

prog_longname="Archive Daemon"
prog_shortname=rmarchived
prog_projprefix=archiving
prog_cliopts="--hostname $( uname -n | cut -d. -f1 )"
prog_syslogtag=rm-archived

callback_before_startup() {
	/usr/bin/rmarchived-hAPI
}

. /usr/share/rmdaemonscripts/init.sh

