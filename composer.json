{
  "config": {
    "vendor-dir": "scripts/vendor",
    "platform": {
      "php": "5.4"
    }
  },
  "minimum-stability": "stable",
  "autoload": {
    "classmap": [
      "scripts/inc/",

      "/usr/share/php/eventlog/",
      "/usr/share/php/syslogger/",
      "/usr/share/php/rmapp/",
      "/usr/share/php/rmdaemonscripts/",
      "/usr/share/php/s3/",
      "/usr/share/php/rmbranding/"
    ],
    "files": [
      "/usr/share/php/hPHP/hapi.php",
      "/usr/share/php/syslogger/class.SysLogger.php",
      "/usr/share/php/rmapp/class.BaseApp.php",
      "/usr/share/php/eventlog/class.EventLog.php",
      "/usr/share/php/rmdaemonscripts/DaemonScripts.php",
      "/usr/share/php/s3/S3.php"
    ]
  },
  "repositories": [
    {
      "type": "git",
      "url": "ssh://git@bitbucket.redmatter.com/lib/php-snow-generator-guzzle5.git"
    },
    {
      "type": "git",
      "url": "ssh://git@bitbucket.redmatter.com/lib/php-snow-block.git"
    }
  ],
  "require": {
    "ext-simplexml": "*",
    "ext-pcntl": "*",
    "ext-json": "*",
    "netresearch/jsonmapper": "^0.11.0",
    "justinrainbow/json-schema": "^2.0",
    "redmatter/snow-generator-guzzle5": "1.*",
    "aws/aws-sdk-php": "2.7.17",
    "phpunit/phpunit": "4.*",
    "paragonie/random_compat": ">=1"
  }
}
