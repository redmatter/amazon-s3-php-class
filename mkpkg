#!/bin/sh

nameroot=RM-archiving
name=$nameroot-0.0.1

#rm -rf $name
rm -rf *.rpm
rm -rf /tmp/$name
rm -rf /usr/src/redhat/RPMS/x86_64/$nameroot-*
mkdir /tmp/$name
cp -r * /tmp/$name
pushd /tmp
tar -czf /usr/src/redhat/SOURCES/$name.tar.gz --exclude=.svn $name/*
rm -rf $name
popd
ver=`svnversion | sed "s/M//g"`
echo "Version $ver"
sed "s/Release: 0/Release: $ver/g" $nameroot.spec > $nameroot.spec.tmp
rpmbuild -bb $nameroot.spec.tmp
rm -rf $nameroot.spec.tmp
cp -fv /usr/src/redhat/RPMS/x86_64/$nameroot-* .
