#!/bin/bash
#
# rmcollect-smsd  This shell script takes care of starting and stopping
#                 the SMS POST Daemon.
#
# chkconfig: 2345 80 05
# description: Archiving Collect Daemon
# processname: rmcollect-smsd
# config: /etc/archiving/rmcollect-smsd.conf
# pidfile: /var/run/archiving/rmcollect-smsd.pid

prog_longname="Archiving Collect SMS Daemon"
prog_shortname=rmcollect-smsd
prog_projprefix=archiving
prog_cliopts="--hostname $( uname -n | cut -d. -f1 )"
prog_syslogtag=rm-collect-smsd

callback_before_startup() {
	/usr/bin/rmarchived-hAPI
}

. /usr/share/rmdaemonscripts/init.sh

