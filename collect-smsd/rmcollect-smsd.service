[Unit]
Description=Archiving Collect SMS Daemon
After=network.target network-online.target

[Service]
PIDFile=/var/run/archiving/rmcollect-smsd.pid
ExecStartPre=/bin/bash /usr/bin/rmarchived-hAPI &>/dev/null
ExecStart=/usr/bin/rmcollect-smsd.bin
SyslogIdentifier=rm-collect-smsd
Restart=on-abort
RestartSec=3s

[Install]
WantedBy=multi-user.target
