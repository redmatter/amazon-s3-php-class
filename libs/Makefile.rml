PROJECT_DIR?=..
include $(PROJECT_DIR)/common/Makefile.macros

RML_GIT_SUBMODULE=libs/rml/rml
RML_DIR=$(PROJECT_DIR)/libs/rml
RML_HPP=$(RML_DIR)/rml/build_config.h

CXX_INCLUDES += -I $(RML_DIR)

$(RML_HPP): $(RML_DIR)/rml
	make -C $(RML_DIR)/rml build_config.h BUILD_INLINE=YES LIBS_MAKEFILES_DIR=$(LIBS_MAKEFILES_DIR) CXX_OPTS=$(CXX_OPTS)

$(RML_DIR)/rml:
	@cd $(PROJECT_DIR) && git submodule update --init --recursive $(RML_GIT_SUBMODULE)

*.cpp: $(RML_HPP)
