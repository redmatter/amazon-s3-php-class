include ../common/Makefile.macros

RML_DATABASE_MYSQL_GIT_SUBMODULE=libs/rml-database-mysql
RML_DATABASE_MYSQL_DIR=$(PROJECT_DIR)/$(RML_DATABASE_MYSQL_GIT_SUBMODULE)
RML_DATABASE_MYSQL_HPP=$(RML_DATABASE_MYSQL_DIR)/rml/database/mysql/connection.hpp

CXX_INCLUDES += -I $(RML_DATABASE_MYSQL_DIR)

$(RML_DATABASE_MYSQL_HPP):
	@cd $(PROJECT_DIR) && git submodule update --init --recursive $(RML_DATABASE_MYSQL_GIT_SUBMODULE)

*.cpp: $(RML_DATABASE_MYSQL_HPP)
