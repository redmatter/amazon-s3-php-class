THIS_MAKEFILE:=$(abspath $(lastword $(MAKEFILE_LIST)))
THIS_DIR:=$(realpath $(dir $(THIS_MAKEFILE)))

PROJECT_DIR:=$(realpath $(THIS_DIR)/..)
EXTERNAL_DIR:=$(PROJECT_DIR)/external

LIBS_MAKEFILES_DIR:=$(PROJECT_DIR)/libs/makefiles

CXX_OPTS = -std=c++11

ARCHIVED_LISTEN_PORT=10100
CPPFLAGS += -DARCHIVED_LISTEN_PORT='"$(ARCHIVED_LISTEN_PORT)"' \
	-DCRYPTOPP_ENABLE_NAMESPACE_WEAK=1

$(info *** CENTOS_VERSION: $(CENTOS_VERSION) ***)
ifeq ($(CENTOS_VERSION),7)
MYSQLCLIENT_LIBS_DIR = -L/usr/lib64/mysql
endif
