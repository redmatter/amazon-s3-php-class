#!/bin/sh

PKG=RM-archiving
MYSQL_USER=archiving
MYSQL_PURGE_USER=archiving-purge
CONFIG_DB_CDRMUNCH=/etc/archiving/conf.d/cdrmunch_database.conf
CONFIG_DB_RETENTION=/etc/archiving/conf.d/retention_database.conf
CONFIG_DB_RETENTION_DELETE=/etc/archiving/conf.d/retention_delete_database.conf
CONFIG_DB_INTERNAL=/etc/archiving/conf.d/internal_database.conf
CONFIG_DB_BIG=/etc/archiving/conf.d/big_database.conf
CONFIG_COLLECTD=/etc/archiving/rmcollectd.conf
CONFIG_COLLECTSMSD=/etc/archiving/rmcollect-smsd.conf
CONFIG_COLLECTIMPORTD=/etc/archiving/rmcollect-importd.conf

hapi_hosttype="$(hapi get HostType)"
IsHapiHostType()
{
    for ((i=1; i<=$#; i++)); do
        if [ "$hapi_hosttype" = "$(echo "${!i}" | tr '[:lower:]' '[:upper:]')" ]; then
            return 0
        fi
    done

    return 1
}

function Die
{
	echo "$1"
	exit 1
}

function ChangeConfig
{
	CFG=$1
	KEY=$2
	VAL=$(echo "$3" | sed -e 's/[\/&]/\\&/g')

	if `egrep "^${PKG}\$" /etc/RedMatterCfgExclude &> /dev/null`; then
		return
	fi

	if `egrep "^${PKG}:${KEY}\$" /etc/RedMatterCfgExclude &> /dev/null`; then
		return
	fi

	sed -i "s#${KEY} \(.*\)#${KEY} = ${VAL}#" $CFG || Die "Unable to set ${KEY} = ${VAL} in ${CFG}"
}

HOSTTYPE=`hapi get HostType`
if [ $? != 0 ]; then
	Die "Failed to call hapi get HostType"
fi

SEARCHDOMAIN=`hapi get SearchDomain`
if [ $? != 0 ]; then
	Die "Failed to call hapi get SearchDomain"
fi

LOCNAME=`hapi get LocName`
if [ $? != 0 ]; then
	Die "Failed to call hapi get LocName"
fi

if [ -f $CONFIG_DB_INTERNAL ]; then
	MYSQL_DB=ArchivingInternal
	MYSQL_RO=`hapi mysql $MYSQL_USER $MYSQL_DB host ro || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB host ro"`
	MYSQL_RW=`hapi mysql $MYSQL_USER $MYSQL_DB host rw || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB host rw"`
	MYSQL_PW=`hapi mysql $MYSQL_USER $MYSQL_DB pass || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB pass"`

	hapi mysql $MYSQL_USER $MYSQL_DB test ro || echo "TEST FAILED TO RO DATABASE CONNECTION: ${MYSQL_USER}@${MYSQL_DB}"
	hapi mysql $MYSQL_USER $MYSQL_DB test rw || echo "TEST FAILED TO RW DATABASE CONNECTION: ${MYSQL_USER}@${MYSQL_DB}"

	ChangeConfig $CONFIG_DB_INTERNAL mysql_internal.host $MYSQL_RW
	ChangeConfig $CONFIG_DB_INTERNAL mysql_internal.password $MYSQL_PW
fi

if [ -f $CONFIG_DB_CDRMUNCH ]; then
	MYSQL_DB=CDR
	MYSQL_RO=`hapi mysql $MYSQL_USER $MYSQL_DB host ro || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB host ro"`
	MYSQL_RW=`hapi mysql $MYSQL_USER $MYSQL_DB host rw || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB host rw"`
	MYSQL_PW=`hapi mysql $MYSQL_USER $MYSQL_DB pass || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB pass"`
	
	hapi mysql $MYSQL_USER $MYSQL_DB test ro || echo "TEST FAILED TO RO DATABASE CONNECTION: ${MYSQL_USER}@${MYSQL_DB}"
	hapi mysql $MYSQL_USER $MYSQL_DB test rw || echo "TEST FAILED TO RW DATABASE CONNECTION: ${MYSQL_USER}@${MYSQL_DB}"

	ChangeConfig $CONFIG_DB_CDRMUNCH mysql_cdrmunch.host $MYSQL_RW
	ChangeConfig $CONFIG_DB_CDRMUNCH mysql_cdrmunch.password $MYSQL_PW
fi

if [ -f $CONFIG_DB_RETENTION ]; then
	MYSQL_DB=ArchivingRetention
	MYSQL_RO=`hapi mysql $MYSQL_USER $MYSQL_DB host ro || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB host ro"`
	MYSQL_RW=`hapi mysql $MYSQL_USER $MYSQL_DB host rw || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB host rw"`
	MYSQL_PW=`hapi mysql $MYSQL_USER $MYSQL_DB pass || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB pass"`
	
	hapi mysql $MYSQL_USER $MYSQL_DB test ro || echo "TEST FAILED TO RO DATABASE CONNECTION: ${MYSQL_USER}@${MYSQL_DB}"
	hapi mysql $MYSQL_USER $MYSQL_DB test rw || echo "TEST FAILED TO RW DATABASE CONNECTION: ${MYSQL_USER}@${MYSQL_DB}"

	ChangeConfig $CONFIG_DB_RETENTION mysql_retention.host $MYSQL_RW
	ChangeConfig $CONFIG_DB_RETENTION mysql_retention.password $MYSQL_PW
fi

if [ -f $CONFIG_DB_RETENTION_DELETE ]; then
	MYSQL_DB=ArchivingRetention
	MYSQL_RO=`hapi mysql $MYSQL_PURGE_USER $MYSQL_DB host ro || Die "Failed to call hapi mysql $MYSQL_PURGE_USER $MYSQL_DB host ro"`
	MYSQL_RW=`hapi mysql $MYSQL_PURGE_USER $MYSQL_DB host rw || Die "Failed to call hapi mysql $MYSQL_PURGE_USER $MYSQL_DB host rw"`
	MYSQL_PW=`hapi mysql $MYSQL_PURGE_USER $MYSQL_DB pass || Die "Failed to call hapi mysql $MYSQL_PURGE_USER $MYSQL_DB pass"`
	
	hapi mysql $MYSQL_PURGE_USER $MYSQL_DB test ro || echo "TEST FAILED TO RO DATABASE CONNECTION: ${MYSQL_PURGE_USER}@${MYSQL_DB}"
	hapi mysql $MYSQL_PURGE_USER $MYSQL_DB test rw || echo "TEST FAILED TO RW DATABASE CONNECTION: ${MYSQL_PURGE_USER}@${MYSQL_DB}"

	ChangeConfig $CONFIG_DB_RETENTION_DELETE mysql_retention_delete.host $MYSQL_RW
	ChangeConfig $CONFIG_DB_RETENTION_DELETE mysql_retention_delete.password $MYSQL_PW
fi

if [ -f $CONFIG_DB_BIG ]; then
	MYSQL_DB=Logs
	MYSQL_RW=`hapi mysql $MYSQL_USER $MYSQL_DB host rw || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB host rw"`
	MYSQL_PW=`hapi mysql $MYSQL_USER $MYSQL_DB pass || Die "Failed to call hapi mysql $MYSQL_USER $MYSQL_DB pass"`

	ChangeConfig $CONFIG_DB_BIG mysql_big.host $MYSQL_RW
	ChangeConfig $CONFIG_DB_BIG mysql_big.password $MYSQL_PW
fi

if [ -f $CONFIG_COLLECTD ]; then
	# AU collectd's get double the thread count
	hapi get LocRegion AU && ChangeConfig $CONFIG_COLLECTD archived_connection_pool.max_connections 32
fi

if [ -f $CONFIG_COLLECTSMSD ]; then
	ChangeConfig $CONFIG_COLLECTSMSD archived_client.server_host "archived.${SEARCHDOMAIN}"
	ChangeConfig $CONFIG_COLLECTSMSD coreapi.url "http://cdr.coreapi.${SEARCHDOMAIN}/"
	ChangeConfig $CONFIG_COLLECTSMSD sms.directory "/mnt/rmfs/archiving-import-sms/$LOCNAME/"
	IsHapiHostType DEV QA && ChangeConfig $CONFIG_COLLECTSMSD log.level 6
	IsHapiHostType DEV QA && ChangeConfig $CONFIG_COLLECTSMSD debug.disable_restart true
	IsHapiHostType DEV QA && ChangeConfig $CONFIG_COLLECTSMSD app.on_restart_notify_emails "dino@redmatter.com,jim@redmatter.com,qa@redmatter.com"
fi

if [ -f $CONFIG_COLLECTIMPORTD ]; then
	ChangeConfig $CONFIG_COLLECTIMPORTD archived_client.server_host "archived.${SEARCHDOMAIN}"
	ChangeConfig $CONFIG_COLLECTIMPORTD coreapi.url "http://cdr.coreapi.${SEARCHDOMAIN}/"
	ChangeConfig $CONFIG_COLLECTIMPORTD import.directory "/mnt/rmfs/archiving-import/$LOCNAME/"
	IsHapiHostType DEV QA && ChangeConfig $CONFIG_COLLECTIMPORTD log.level 6
	IsHapiHostType DEV QA && ChangeConfig $CONFIG_COLLECTIMPORTD debug.disable_restart true
	IsHapiHostType DEV QA && ChangeConfig $CONFIG_COLLECTIMPORTD app.on_restart_notify_emails "dino@redmatter.com,jim@redmatter.com,qa@redmatter.com"
fi
exit 0
