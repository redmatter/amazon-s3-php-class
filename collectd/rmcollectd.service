[Unit]
Description=Archiving Collect Daemon
After=network.target network-online.target

[Service]
PIDFile=/var/run/archiving/rmcollectd.pid
ExecStartPre=/bin/bash /usr/bin/rmarchived-hAPI &>/dev/null
ExecStart=/usr/bin/rmcollectd.bin
SyslogIdentifier=rm-collectd
Restart=on-abort
RestartSec=3s

[Install]
WantedBy=multi-user.target
