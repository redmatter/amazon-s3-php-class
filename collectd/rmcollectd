#!/bin/bash
#
# rmcollectd     This shell script takes care of starting and stopping
#                the CDR POST Daemon.
#
# chkconfig: 2345 80 05
# description: Archiving Collect Daemon
# processname: rmcollectd
# config: /etc/archiving/rmcollectd.conf
# pidfile: /var/run/archiving/rmcollectd.pid

prog_longname="Archiving Collect Daemon"
prog_shortname=rmcollectd
prog_projprefix=archiving
prog_cliopts="--hostname $( uname -n | cut -d. -f1 )"
prog_syslogtag=rm-collectd

callback_before_startup() {
	/usr/bin/rmarchived-hAPI
}

. /usr/share/rmdaemonscripts/init.sh

